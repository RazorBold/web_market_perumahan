# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (then redeploy).

# NEXT_PUBLIC_WHATSAPP_NUMBER: Sales WhatsApp number used by every "Hubungi/Jadwalkan" button
# and form. International format without "+" or spaces. Inlined at build time.
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# NEXT_PUBLIC_SITE_URL: Canonical URL once a custom domain is attached (used for sitemap,
# Open Graph and canonical links). On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL="https://hyarta-ecovillage.com"

# LEAD_WEBHOOK_URL (optional, server-only): Every KPR / visit form submission is POSTed here
# as JSON { source, name, phone, detail, createdAt }. Works with Google Apps Script (Sheets),
# Make, Zapier, n8n, Slack or Discord webhooks. Without it, leads only appear in Vercel logs.
LEAD_WEBHOOK_URL=""
